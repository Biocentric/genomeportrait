/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        nextflow run your-org/genomeportrait -profile test_full,singularity --outdir results
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size test: NA12878 30x WGS, all modules enabled'

    // Full public 30x WGS for the Genome in a Bottle reference sample HG001/NA12878
    input  = "${projectDir}/assets/samplesheet_full.csv"
    genome = 'GRCh38'

    // Everything on
    skip_ancestry          = false
    skip_haplogroups       = false
    skip_str               = false
    skip_prs               = false
    skip_hla               = false
    skip_pharmcat          = false
    skip_traits            = false
    skip_telomere          = false
    skip_mito_heteroplasmy = false
    call_sv                = true
    call_cnv               = true
}
