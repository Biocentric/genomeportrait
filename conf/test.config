/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run your-org/genomeportrait -profile test,singularity --outdir results
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function (chr21 subset)'

    // Limit resources so the test runs on a laptop / CI
    max_cpus   = 4
    max_memory = '12.GB'
    max_time   = '4.h'

    // Small chr21 test data (NA12878 subset)
    input  = "${projectDir}/assets/samplesheet_test.csv"
    genome = 'GRCh38_chr21'

    // Fast wiring smoke-test: exercise align → call → report, skip the steps that need
    // multi-GB databases (VEP cache, gnomAD, HGDP panel). Use `test_30x` for the full flow.
    skip_bqsr              = true   // tiny test data; also avoids known-sites name clash
    skip_annotation        = true
    skip_ancestry          = true
    skip_prs               = true
    skip_hla               = true
    skip_pharmcat          = true
    skip_str               = true
    skip_traits            = true
    // tiny test genome has no chrM/Y and isn't genome-wide — skip lineage/extras here
    skip_haplogroups       = true
    skip_telomere          = true
    skip_mito_heteroplasmy = true
    call_sv                = false
    call_cnv               = false
    variant_caller     = 'deepvariant'
    dv_model_type      = 'WGS'
}
