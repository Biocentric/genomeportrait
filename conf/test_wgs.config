/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config: ALL-FEATURES test on down-sampled whole-genome data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    NA12878 down-sampled from 30x to ~8x across the WHOLE genome, so every interpretation
    layer has real input (HLA on chr6, mtDNA/chrM, chrY, the genome-wide ancestry SNP set,
    telomeric reads, pharmacogenes, trait SNPs). Unlike the chr21 tests, nothing is skipped.

    Prepare data first (one-off; uses containerised samtools, ~16 GB download):
        bash assets/prepare_test_wgs.sh
    Then:
        nextflow run . -profile test_wgs,singularity --outdir results_wgs

    Heavy: pulls the full GRCh38 refs + VEP cache + 1000G/HGDP ancestry panel + PGS files.
    CPU DeepVariant genome-wide at 8x takes a while (no GPU here). gnomAD AF comes from the
    VEP cache (no separate gnomAD download).
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Whole-genome all-features test (~8x NA12878)'
    config_profile_description = 'Down-sampled WGS so every feature runs on real data'

    input  = "${projectDir}/testdata/samplesheet_wgs8x.csv"
    genome = 'GRCh38'

    max_cpus   = 40    // use all threads on the box
    max_memory = '120.GB'
    max_time   = '96.h'

    // Everything ON
    skip_qc                = false
    skip_annotation        = false
    skip_ancestry          = true    // TODO: 1000G+HGDP PLINK2 panel not cleanly wget-able (refs 404); needs gdown or build-from-VCF
    skip_haplogroups       = false
    skip_str               = false
    skip_prs               = false
    skip_hla               = false
    skip_pharmcat          = false
    skip_traits            = false
    skip_telomere          = false
    skip_mito_heteroplasmy = false
    call_sv                = true
    call_cnv               = true    // CNVpytor (read-depth, efficient for single-sample WGS)

    use_snpsift_gnomad     = false   // gnomAD AF via VEP cache
    variant_caller         = 'deepvariant'
    dv_model_type          = 'WGS'
}

// Qualimap can choke on edge-case BAMs; don't let it abort the run.
// Give the CPU-bound bottleneck steps all available cores (single-sample run).
process {
    withName: 'QUALIMAP_BAMQC'      { errorStrategy = 'ignore' }
    withName: '.*:BWAMEM2_MEM'      { cpus = 40 }
    withName: '.*:DEEPVARIANT.*'    { cpus = 40 }
    withName: 'MANTA_GERMLINE'      { cpus = 40 }
    withName: 'CNVPYTOR'            { cpus = 16 }
    withName: '.*:SAMTOOLS_SORT'    { cpus = 16 }

    // Front-to-back functional test: one feature failing must not abort the whole run.
    // Core path (align/markdup/BQSR/DeepVariant/VEP/final report/MultiQC) stays strict.
    withName: 'PGSCATALOG_DOWNLOAD|PLINK2_VCF2PGEN|PLINK2_SCORE|PRS_REPORT|HLA_T1K|HLA_REPORT|PHARMCAT|PHARMCAT_REPORT|MITO_CALL|HAPLOGREP2|YLEAF|LINEAGE_REPORT|HIPSTR|EXPANSIONHUNTER|STR_REPORT|TRAIT_LOOKUP|TELSEQ|MUTSERVE|EXTRAS_REPORT|MANTA_GERMLINE|CNVPYTOR|SVCNV_SUMMARY|BUILD_HIPSTR_CONTAINER' {
        errorStrategy = 'ignore'
    }
}
