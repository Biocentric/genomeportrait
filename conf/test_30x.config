/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config: full-flow test on real 30x chr21 data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises the WHOLE pipeline on genuine 30x WGS reads restricted to chromosome 21
    (NA12878 / HG001). chr21-only reads keep alignment + variant calling fast, while the
    full GRCh38 references make every stage behave exactly as in a real run.

    Prepare the data first (one-off, needs ~a few GB + samtools):
        bash assets/prepare_test_chr21.sh
    Then run:
        nextflow run . -profile test_30x,singularity --outdir results_test30x

    Notes:
      * The first run downloads the full GRCh38 reference set incl. the Ensembl VEP cache
        (~25 GB) into --reference_base; this is cached and only happens once.
      * Ancestry and polygenic scoring are genome-wide methods and are left OFF here because
        chr21-only input is not meaningful for them. Every other stage runs; interpretation
        tables for loci that don't fall on chr21 (most "fun" traits, CODIS, HLA, PGx) will be
        sparse/empty by design — that still validates the full code path end to end.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = '30x chr21 full-flow test'
    config_profile_description  = 'Real 30x NA12878 reads restricted to chr21, full GRCh38 references, most stages enabled'

    input  = "${projectDir}/testdata/samplesheet_chr21_30x.csv"
    genome = 'GRCh38'

    max_cpus   = 16
    max_memory = '120.GB'   // full GRCh38 bwa-mem2 index build needs ~70 GB RAM
    max_time   = '48.h'

    // Stages meaningful on chr21-only input. The key addition vs the smoke test is the
    // real variant-calling + VEP/gnomAD/ClinVar ANNOTATION path on genuine variants.
    skip_qc                = false
    skip_annotation        = false   // VEP + gnomAD(chr21) + ClinVar
    skip_str               = false   // HipSTR (runtime-built container) + ExpansionHunter on chr21 loci
    skip_traits            = false   // (most trait SNPs are off-chr21, so sparse)
    skip_telomere          = false
    call_sv                = true    // Manta SV on chr21
    call_cnv               = false   // CNVkit WGS bins genome-wide — not meaningful (and OOM-heavy) on chr21-only input

    // Off: these need chromosomes not present in chr21-only input
    skip_ancestry          = true   // genome-wide HGDP panel
    skip_prs               = true   // PGS scores are genome-wide
    skip_hla               = true   // HLA is on chr6
    skip_pharmcat          = true   // PGx genes mostly off-chr21
    skip_haplogroups       = true   // mtDNA/Y not in chr21 reads
    skip_mito_heteroplasmy = true   // no chrM reads

    variant_caller         = 'deepvariant'
    dv_model_type          = 'WGS'
}

// gnomAD v4.1 has no single genome-wide file; for this chr21 test use the chr21 sites
// VCF (the only resource that needs scoping — fasta/known-sites/VEP cache stay full GRCh38).
params {
    references {
        'GRCh38' {
            gnomad = 'https://storage.googleapis.com/gcp-public-data--gnomad/release/4.1/vcf/genomes/gnomad.genomes.v4.1.sites.chr21.vcf.bgz'
        }
    }
}

// Qualimap can choke on edge-case BAMs; don't let it abort the run.
process {
    withName: 'QUALIMAP_BAMQC' { errorStrategy = 'ignore' }
}
