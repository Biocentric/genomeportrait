/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config: full-flow test on real 30x chr21 data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises the WHOLE pipeline on genuine 30x WGS reads restricted to chromosome 21
    (NA12878 / HG001). chr21-only reads keep alignment + variant calling fast, while the
    full GRCh38 references make every stage behave exactly as in a real run.

    Prepare the data first (one-off, needs ~a few GB + samtools):
        bash assets/prepare_test_chr21.sh
    Then run:
        nextflow run . -profile test_30x,singularity --outdir results_test30x

    Notes:
      * The first run downloads the full GRCh38 reference set incl. the Ensembl VEP cache
        (~25 GB) into --reference_base; this is cached and only happens once.
      * Ancestry and polygenic scoring are genome-wide methods and are left OFF here because
        chr21-only input is not meaningful for them. Every other stage runs; interpretation
        tables for loci that don't fall on chr21 (most "fun" traits, CODIS, HLA, PGx) will be
        sparse/empty by design — that still validates the full code path end to end.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = '30x chr21 full-flow test'
    config_profile_description  = 'Real 30x NA12878 reads restricted to chr21, full GRCh38 references, most stages enabled'

    input  = "${projectDir}/testdata/samplesheet_chr21_30x.csv"
    genome = 'GRCh38'

    max_cpus   = 16
    max_memory = '72.GB'
    max_time   = '48.h'

    // Whole flow except the two genome-wide-only interpretation layers
    skip_qc                = false
    skip_annotation        = false
    skip_haplogroups       = false
    skip_str               = false
    skip_hla               = false
    skip_pharmcat          = false
    skip_traits            = false
    skip_telomere          = false
    skip_mito_heteroplasmy = false
    call_sv                = true
    call_cnv               = true

    skip_ancestry          = true   // needs genome-wide HGDP panel
    skip_prs               = true   // PGS scores are genome-wide

    variant_caller         = 'deepvariant'
    dv_model_type          = 'WGS'
}
