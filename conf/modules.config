/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // ---------------- QC / trimming ----------------
    withName: 'FASTP' {
        ext.args   = '--detect_adapter_for_pe --cut_right --cut_right_window_size 4 --cut_right_mean_quality 20 --length_required 50'
        publishDir = [ path: { "${params.outdir}/qc/fastp/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'FASTQC' {
        ext.args   = '--quiet'
        publishDir = [ path: { "${params.outdir}/qc/fastqc/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'MOSDEPTH' {
        ext.args   = '--no-per-base --by 1000 --fast-mode'
        publishDir = [ path: { "${params.outdir}/qc/mosdepth/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'QUALIMAP_BAMQC' {
        publishDir = [ path: { "${params.outdir}/qc/qualimap/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ---------------- Alignment ----------------
    withName: 'BWAMEM2_MEM' {
        ext.args   = { "-R \"@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.id}\\tPL:${meta.platform.toUpperCase()}\"" }
        ext.args2  = '-M'
    }
    withName: 'MINIMAP2_ALIGN' {
        ext.args   = { "-R \"@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:${meta.platform.toUpperCase()}\" --MD" }
    }
    withName: 'GATK4_MARKDUPLICATES' {
        ext.args   = '--OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500'
        ext.prefix = { "${meta.id}.markdup" }
        publishDir = [ path: { "${params.outdir}/alignment/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.{bam,bai,cram,crai,metrics}' ]
    }
    withName: 'GATK4_APPLYBQSR' {
        ext.prefix = { "${meta.id}.recal" }
        publishDir = [ path: { "${params.outdir}/alignment/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.{cram,crai}' ]
    }

    // ---------------- Small variants ----------------
    withName: 'DEEPVARIANT_RUNDEEPVARIANT' {
        ext.args   = { "--model_type=${params.dv_model_type}" }
        publishDir = [ path: { "${params.outdir}/variants/deepvariant/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'GLNEXUS' {
        ext.args   = '--config DeepVariant'
    }
    withName: 'BCFTOOLS_NORM' {
        ext.args   = '--multiallelics -both --check-ref w'
        ext.prefix = { "${meta.id}.norm" }
    }

    // ---------------- SV / CNV ----------------
    withName: 'MANTA_GERMLINE' {
        publishDir = [ path: { "${params.outdir}/variants/manta/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'CNVPYTOR' {
        ext.args   = '100000'   // read-depth bin size (bp)
        publishDir = [ path: { "${params.outdir}/variants/cnvpytor/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ---------------- Annotation ----------------
    withName: 'ENSEMBLVEP_VEP' {
        ext.args   = [
            '--everything --hgvs --symbol --canonical --mane --biotype --af_gnomadg',
            '--pick_allele_gene --check_existing --buffer_size 50000 --offline --cache'
        ].join(' ')
        publishDir = [ path: { "${params.outdir}/annotation/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'SNPSIFT_ANNOTATE_CLINVAR' {
        ext.prefix = { "${meta.id}.clinvar" }
    }

    // ---------------- Ancestry ----------------
    withName: 'PLINK2_PCA_PROJECT' {
        ext.args   = '--maf 0.01 --geno 0.05 --hwe 1e-6'
        publishDir = [ path: { "${params.outdir}/ancestry/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'ADMIXTURE_SUPERVISED' {
        publishDir = [ path: { "${params.outdir}/ancestry/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'PLINK2_ROH' {
        ext.args   = '--homozyg --homozyg-window-snp 50 --homozyg-snp 100 --homozyg-kb 1000'
    }

    // ---------------- Haplogroups ----------------
    withName: 'HAPLOGREP2' {
        publishDir = [ path: { "${params.outdir}/lineage/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'YLEAF' {
        publishDir = [ path: { "${params.outdir}/lineage/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ---------------- STR ----------------
    withName: 'HIPSTR' {
        publishDir = [ path: { "${params.outdir}/forensic_str/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'EXPANSIONHUNTER' {
        publishDir = [ path: { "${params.outdir}/forensic_str/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ---------------- PRS ----------------
    withName: 'PGSCATALOG_DOWNLOAD' {
        publishDir = [ path: { "${params.outdir}/polygenic/scorefiles" }, mode: params.publish_dir_mode ]
    }
    withName: 'PLINK2_SCORE' {
        ext.args   = '--score-col-nums 3 header-read list-variants cols=+scoresums,+denom'
        publishDir = [ path: { "${params.outdir}/polygenic/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ---------------- HLA ----------------
    withName: 'HLA_T1K' {
        ext.args   = '--preset hla-wgs'
        publishDir = [ path: { "${params.outdir}/hla/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ---------------- Pharmacogenomics ----------------
    withName: 'PHARMCAT' {
        publishDir = [ path: { "${params.outdir}/pharmacogenomics/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ---------------- Traits / extras ----------------
    withName: 'TRAIT_LOOKUP' {
        publishDir = [ path: { "${params.outdir}/traits/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'TELSEQ' {
        publishDir = [ path: { "${params.outdir}/extras/telomere/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'MUTSERVE' {
        publishDir = [ path: { "${params.outdir}/extras/mito/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ---------------- Reporting ----------------
    withName: 'GENOMEPORTRAIT_REPORT' {
        publishDir = [ path: { "${params.outdir}/report" }, mode: params.publish_dir_mode ]
    }
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [ path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode ]
    }

    withName: 'CUSTOM_DUMPSOFTWAREVERSIONS' {
        publishDir = [ path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode, pattern: '*_versions.yml' ]
    }
}
