/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    genomeportrait PRODUCTION config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The normal, everyday profile for real whole-genome runs. Provide your own data:

        nextflow run . -profile production --input samplesheet.csv \
            --outdir results --reference_base /path/to/refs

    Sized for a 19-core slice of the box (the rest stays free for other work). Heavy
    callers are capped so the long DeepVariant stage leaves cores spare for the many small
    interpretation tasks (QC, STR, HLA, traits, ancestry genotyping, mito, ...) to run in
    parallel in the same pool. Every interpretation feature is tolerant: one failing module
    can't abort a personal-genome run. Longer wall-times are accepted in exchange.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Production (19-core)'
    config_profile_description = 'Everyday whole-genome production profile, all features on'

    genome     = 'GRCh38'

    // 19 cores of the machine; generous RAM since CPU is the bottleneck.
    max_cpus   = 19
    max_memory = '130.GB'
    max_time   = '240.h'

    // Everything on (ancestry is opt-out by default now); tune per-run with --skip_* as wanted.
    use_snpsift_gnomad = false   // gnomAD AF via the VEP cache (no separate per-chrom download)
    variant_caller     = 'deepvariant'
    dv_model_type      = 'WGS'
}

// Bound the local executor to a 19-thread / RAM pool so independent small tasks PACK and run
// concurrently (Nextflow schedules tasks while their summed cpus/memory fit the pool).
executor {
    cpus   = 19
    memory = '130.GB'
}

process {
    // ---- Balance the heavy callers so the pool isn't monopolised ----
    // DeepVariant is the long pole; capping it at 12 leaves 7 cores for the parallel swarm
    // of interpretation tasks that only need the BAM/VCF.
    withName: '.*:BWAMEM2_MEM'       { cpus = 16; memory = '72.GB' }
    withName: '.*:DEEPVARIANT.*'     { cpus = 12; memory = '64.GB' }
    withName: 'MANTA_GERMLINE'       { cpus = 8  }
    withName: 'CNVPYTOR'             { cpus = 8  }
    withName: '.*:SAMTOOLS_SORT'     { cpus = 8  }
    withName: 'ADMIXTURE_SUPERVISED' { cpus = 12 }

    // Qualimap can choke on edge-case BAMs; never let it abort the run.
    withName: 'QUALIMAP_BAMQC'       { errorStrategy = 'ignore' }

    // ---- Feature tolerance: a single interpretation module failing must not abort ----
    // Core path (align/markdup/BQSR/DeepVariant/VEP/final report/MultiQC) stays strict.
    withName: 'PGSCATALOG_DOWNLOAD|PLINK2_VCF2PGEN|PLINK2_SCORE|PRS_REPORT|HLA_EXTRACT_FASTQ|HLA_T1K|HLA_REPORT|PHARMCAT|PHARMCAT_REPORT|MITO_CALL|HAPLOGREP2|YLEAF|DOWNLOAD_YLEAF_DATA|BUILD_YLEAF_CONTAINER|LINEAGE_REPORT|HIPSTR|EXPANSIONHUNTER|STR_REPORT|TRAIT_LOOKUP|TRAIT_GENOTYPE|TELSEQ|MUTSERVE|EXTRAS_REPORT|MANTA_GERMLINE|CNVPYTOR|SVCNV_SUMMARY|BUILD_HIPSTR_CONTAINER|VCF_TO_TABLE|SNPSIFT_CLINVAR|DOWNLOAD_KGP_HGDP|PLINK2_ANCESTRY_PANEL|BCFTOOLS_GENOTYPE_SITES|PLINK2_ANCESTRY_SAMPLE|PLINK_ANCESTRY_MERGE|PLINK2_PCA_PROJECT|ADMIXTURE_SUPERVISED|PLINK2_ROH|KING_KINSHIP|ANCESTRY_REPORT' {
        errorStrategy = 'ignore'
    }
}
