/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    your-org/genomeportrait Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

plugins {
    id 'nf-schema@2.2.0'
}

params {

    // ---------- Input / output ----------
    input                      = null
    outdir                     = null
    reference_base             = "${projectDir}/references"
    publish_dir_mode           = 'copy'

    // ---------- Reference genome ----------
    genome                     = 'GRCh38'
    igenomes_ignore            = true
    download_references        = true   // set false if reference_base already populated

    // ---------- Sequencing / platform ----------
    seq_platform               = 'illumina'   // illumina | ont | pacbio
    aligner                    = 'bwa-mem2'    // bwa-mem2 | minimap2
    skip_trimming              = false
    skip_bqsr                  = false

    // ---------- Variant calling ----------
    variant_caller             = 'deepvariant' // deepvariant | haplotypecaller | clair3
    dv_model_type              = 'WGS'         // WGS | WES | PACBIO | ONT_R104
    call_sv                    = true
    call_cnv                   = true

    // ---------- Module toggles ----------
    skip_qc                    = false
    skip_annotation            = false
    skip_ancestry              = true   // requires large 1000G+HGDP panel; opt-in
    skip_haplogroups           = false
    skip_str                   = false
    skip_prs                   = false
    skip_hla                   = false
    skip_pharmcat              = false
    skip_traits                = false
    skip_telomere              = false
    skip_mito_heteroplasmy     = false
    skip_multiqc               = false

    // ---------- Polygenic scoring ----------
    // Comma-separated PGS Catalog IDs to compute (educational/recreational traits).
    pgs_ids                    = 'PGS000297,PGS002724,PGS000845,PGS001780'
    pgs_min_overlap            = 0.75

    // ---------- Trait panel ----------
    trait_panel                = "${projectDir}/assets/trait_snps.tsv"

    // ---------- VEP ----------
    vep_cache_version          = 113
    vep_species                = 'homo_sapiens'

    // ---------- Report container (built locally by the pipeline; no registry hosting needed) ----------
    build_report_container     = true
    report_image_version       = '1.0.0'
    report_sif                 = "${params.reference_base}/containers/genomeportrait-report-1.0.0.sif"
    report_docker              = 'genomeportrait-report:1.0.0'

    // ---------- MultiQC ----------
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // ---------- Boilerplate ----------
    help                       = false
    help_full                  = false
    show_hidden                = false
    version                    = false
    validate_params            = true
    monochrome_logs            = false
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    hook_url                   = null
    config_profile_name        = null
    config_profile_description = null
    config_profile_contact     = null
    config_profile_url         = null
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"

    // ---------- Resource limits ----------
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        conda.channels          = ['conda-forge', 'bioconda']
    }
    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        singularity.enabled     = false
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        // Cache pulled .sif images so we never re-pull
        singularity.cacheDir    = "${params.reference_base}/singularity_cache"
        docker.enabled          = false
        conda.enabled           = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = "${params.reference_base}/singularity_cache"
        docker.enabled          = false
    }
    test          { includeConfig 'conf/test.config'      }
    test_30x      { includeConfig 'conf/test_30x.config'  }
    test_full     { includeConfig 'conf/test_full.config' }
}

// Load modules.config for DSL2 module-specific options
includeConfig 'conf/modules.config'

// Load reference download URLs / index logic
includeConfig 'conf/references.config'

// Export these variables to prevent local Python/R libraries from conflicting with those in containers
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Trace / report
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"   }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"     }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"       }

manifest {
    name            = 'your-org/genomeportrait'
    author          = 'genomeportrait contributors'
    homePage        = 'https://github.com/your-org/genomeportrait'
    description     = 'State-of-the-art personal whole-genome sequencing analysis for recreational, ancestry and educational genomics.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0dev'
    doi             = ''
}

// Resource ceilings are enforced via process.resourceLimits in conf/base.config
// (the old check_max() helper is not compatible with the strict config parser).
