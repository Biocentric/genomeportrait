/*
    Stub run: every module switched on, each task replaced by its stub block (empty
    placeholder outputs). Checks the wiring of the whole pipeline in a minute or two,
    without containers, data or downloads, for the three input modes at once.

        sed "s#STUBDIR#$PWD/tests/stub#g" tests/stub/samplesheet.csv > stub-samplesheet.csv
        nextflow run . -profile test_stub -stub --input stub-samplesheet.csv --outdir stub-results

    or `nf-test test tests/stub.nf.test`, which writes the samplesheet itself.

    No container profile: stub blocks only create files. reference_base must be throw-away
    (main.nf refuses a stub run otherwise): stub tasks leave placeholders in its caches.
*/
params {
    config_profile_name        = 'Stub profile'
    config_profile_description = 'All modules on, stub blocks only (wiring check)'
    reference_base = "${launchDir}/stub-references"
    max_cpus       = 2
    max_memory     = '4.GB'
    max_time       = '1.h'
    skip_bqsr      = false   // exercise the BQSR branch too
    use_gpu        = 'off'
}
