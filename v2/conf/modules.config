/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // ---------------- Publishing ----------------
    // Nothing is published unless listed here, and every result lands in one tree per sample:
    //   <outdir>/<sample>/{alignment,variants,qc,annotation,ancestry,lineage,str,polygenic,
    //                      hla,pharmacogenomics,traits,extras}/  and  <outdir>/<sample>/<sample>.genomeportrait.html
    // Run-level files: <outdir>/multiqc/, <outdir>/pipeline_info/. References, indices,
    // containers and intermediates are never copied (in v1 that was ~360 GB per 40x genome).
    // versions.yml is never published; the collated versions are in pipeline_info/.
    publishDir = [ enabled: false ]

    withName: 'FASTP' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/qc/fastp" }, mode: params.publish_dir_mode, pattern: '*.{json,html,log}' ]
    }
    withName: 'FASTQC' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/qc/fastqc" }, mode: params.publish_dir_mode, pattern: '*.{html,zip}' ]
    }
    withName: 'MOSDEPTH' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/qc/mosdepth" }, mode: params.publish_dir_mode, pattern: '*.{txt,bed.gz}' ]
    }
    withName: 'GENOME_FACTS|SAMTOOLS_STATS|VERIFYBAMID2|CONTAMINATION_REPORT' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/qc" }, mode: params.publish_dir_mode, pattern: '*.{tsv,stats,selfSM,Ancestry}' ]
    }
    withName: 'QUALIMAP_BAMQC' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/qc/qualimap" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'GATK4_MARKDUPLICATES' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/alignment" }, mode: params.publish_dir_mode, pattern: '*.metrics' ]
    }
    withName: 'SAMTOOLS_BAM2CRAM|GATK4_APPLYBQSR' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/alignment" }, mode: params.publish_dir_mode, pattern: '*.{cram,crai}' ]
    }
    withName: 'BWAMEM2_MARKDUP_CRAM' {
        // without BQSR this CRAM is the deliverable; with BQSR the recalibrated one is
        publishDir = [ path: { "${params.outdir}/${meta.id}/alignment" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : (f.endsWith('.stats') || params.skip_bqsr) ? f : null } ]
    }
    withName: 'PARABRICKS_FQ2BAM|PARABRICKS_FQ2BAM_DOCKER' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/alignment" }, mode: params.publish_dir_mode, pattern: '*.{bam,bai}' ]
    }
    withName: 'DEEPVARIANT_RUNDEEPVARIANT|PARABRICKS_DEEPVARIANT|GATK4_HAPLOTYPECALLER|CLAIR3' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/variants" }, mode: params.publish_dir_mode, pattern: '*.{vcf.gz,vcf.gz.tbi}' ]
    }
    withName: 'BCFTOOLS_NORM|BCFTOOLS_NORM_GPU|BCFTOOLS_STATS|BCFTOOLS_STATS_INPUT' {
        // the normalised VCF is what portrait mode takes in its `vcf` column
        publishDir = [ path: { "${params.outdir}/${meta.id}/variants" }, mode: params.publish_dir_mode, pattern: '*.{vcf.gz,vcf.gz.tbi,txt}' ]
    }
    withName: 'MANTA_GERMLINE|CNVPYTOR|SVCNV_SUMMARY' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/variants/sv_cnv" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'ENSEMBLVEP_VEP|VCF_TO_TABLE' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/annotation" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'PLINK2_PCA_PROJECT|ADMIXTURE_SUPERVISED|ANCESTRY_REPORT' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/ancestry" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'HAPLOGREP2|YLEAF|LINEAGE_REPORT' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/lineage" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'HIPSTR|EXPANSIONHUNTER|STR_REPORT' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/str" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'PGS_TARGET' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/polygenic" }, mode: params.publish_dir_mode, pattern: '*.pgs_target_stats.tsv' ]
    }
    withName: 'PGS_REPORT' {
        // the fragment is only an input to the unified report
        publishDir = [ path: { "${params.outdir}/${meta.id}/polygenic" }, mode: params.publish_dir_mode,
                       saveAs: { f -> (f == 'versions.yml' || f.endsWith('.pgs_fragment.html')) ? null : f } ]
    }
    withName: 'KIR_T1K|KIR_REPORT' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/kir" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'HLA_T1K|HLA_REPORT' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/hla" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'PHARMCAT|PHARMCAT_REPORT|CYRIUS' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/pharmacogenomics" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'BLOOD_GROUPS|RHD_DEPTH' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/traits" }, mode: params.publish_dir_mode, pattern: '*.tsv' ]
    }
    withName: 'TRAIT_LOOKUP' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/traits" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'EXPORT_23ANDME' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/export" }, mode: params.publish_dir_mode, pattern: '*.txt.gz' ]
    }
    withName: 'TELSEQ|MUTSERVE|EXTRAS_REPORT' {
        publishDir = [ path: { "${params.outdir}/${meta.id}/extras" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'GENOMEPORTRAIT_REPORT' {
        publishDir = [ path: { "${params.outdir}/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.html' ]
    }
    withName: 'MULTIQC' {
        publishDir = [ path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }

    // ---------------- QC / trimming ----------------
    withName: 'FASTP' {
        ext.args   = '--detect_adapter_for_pe --cut_right --cut_right_window_size 4 --cut_right_mean_quality 20 --length_required 50'
        // reports only: the trimmed FASTQ (~95 GB at 40x) stays in the work dir
    }
    withName: 'FASTQC' {
        ext.args   = '--quiet'
    }
    withName: 'MOSDEPTH' {
        ext.args   = '--no-per-base --by 1000 --fast-mode'
    }

    // ---------------- Alignment ----------------
    withName: 'BWAMEM2_MEM|BWAMEM2_MARKDUP_CRAM' {
        ext.args   = { "-R \"@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.id}\\tPL:${meta.platform.toUpperCase()}\"" }
        ext.args2  = '-M'
    }
    withName: 'MINIMAP2_ALIGN' {
        ext.args   = { "-R \"@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:${meta.platform.toUpperCase()}\" --MD" }
    }
    withName: 'GATK4_MARKDUPLICATES' {
        ext.args   = '--OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500'
        ext.prefix = { "${meta.id}.markdup" }
    }
    withName: 'SAMTOOLS_BAM2CRAM' {
        ext.prefix = { "${meta.id}.md" }
    }
    withName: 'GATK4_APPLYBQSR' {
        ext.prefix = { "${meta.id}.recal" }
    }

    // ---------------- GPU (NVIDIA Parabricks) ----------------
    withName: 'PARABRICKS_FQ2BAM|PARABRICKS_FQ2BAM_DOCKER' {
        ext.args   = '--bwa-options="-K 100000000 -Y"'
    }
    withName: 'BCFTOOLS_NORM_GPU' {
        ext.args   = '--multiallelics -both --check-ref w'
        ext.prefix = { "${meta.id}.norm" }
    }

    // ---------------- Small variants ----------------
    withName: 'DEEPVARIANT_RUNDEEPVARIANT' {
        ext.args   = { "--model_type=${params.dv_model_type}" }
    }
    withName: 'BCFTOOLS_NORM' {
        ext.args   = '--multiallelics -both --check-ref w'
        ext.prefix = { "${meta.id}.norm" }
    }

    // ---------------- SV / CNV ----------------
    withName: 'CNVPYTOR' {
        ext.args   = '100000'   // read-depth bin size (bp)
    }

    // ---------------- Annotation ----------------
    withName: 'ENSEMBLVEP_VEP' {
        ext.args   = [
            '--everything --hgvs --symbol --canonical --mane --biotype --af_gnomadg',
            '--pick_allele_gene --check_existing --buffer_size 50000 --offline --cache'
        ].join(' ')
    }
    withName: 'SNPSIFT_CLINVAR' {
        ext.prefix = { "${meta.id}.clinvar" }
    }

    // ---------------- Ancestry ----------------
    withName: 'PLINK2_PCA_PROJECT' {
        ext.args   = '--maf 0.01 --geno 0.05 --hwe 1e-6'
    }
    withName: 'PLINK2_ROH' {
        ext.args   = '--homozyg --homozyg-window-snp 50 --homozyg-snp 100 --homozyg-kb 1000'
    }

    // ---------------- Polygenic scores ----------------
    withName: 'PGS_MATCH' {
        memory = { 24.GB * task.attempt }   // ~5 GB for the reference table, shared by the workers
    }

    // ---------------- HLA ----------------
    withName: 'HLA_T1K' {
        ext.args   = '--preset hla-wgs'
    }

    // ---------------- Reporting ----------------
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }

}
