/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // ---------------- QC / trimming ----------------
    withName: 'FASTP' {
        ext.args   = '--detect_adapter_for_pe --cut_right --cut_right_window_size 4 --cut_right_mean_quality 20 --length_required 50'
        // reports only: the trimmed FASTQ (~95 GB at 40x) stays in the work dir
        publishDir = [ path: { "${params.outdir}/qc/fastp/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.{json,html,log}' ]
    }
    withName: 'FASTQC' {
        ext.args   = '--quiet'
        publishDir = [ path: { "${params.outdir}/qc/fastqc/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'GENOME_FACTS' {
        publishDir = [ path: { "${params.outdir}/qc/genome_facts/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.tsv' ]
    }
    withName: 'MOSDEPTH' {
        ext.args   = '--no-per-base --by 1000 --fast-mode'
        publishDir = [ path: { "${params.outdir}/qc/mosdepth/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'SAMTOOLS_STATS' {
        publishDir = [ path: { "${params.outdir}/qc/samtools/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.stats' ]
    }
    withName: 'QUALIMAP_BAMQC' {
        publishDir = [ path: { "${params.outdir}/qc/qualimap/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }

    // ---------------- Alignment ----------------
    withName: 'BWAMEM2_MEM' {
        ext.args   = { "-R \"@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.id}\\tPL:${meta.platform.toUpperCase()}\"" }
        ext.args2  = '-M'
    }
    withName: 'MINIMAP2_ALIGN' {
        ext.args   = { "-R \"@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:${meta.platform.toUpperCase()}\" --MD" }
    }
    withName: 'GATK4_MARKDUPLICATES' {
        ext.args   = '--OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500'
        ext.prefix = { "${meta.id}.markdup" }
        // metrics only: the duplicate-marked BAM (~120 GB at 40x) is an intermediate, the CRAM is the deliverable
        publishDir = [ path: { "${params.outdir}/alignment/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.metrics' ]
    }
    withName: 'SAMTOOLS_BAM2CRAM' {
        ext.prefix = { "${meta.id}.md" }
        publishDir = [ path: { "${params.outdir}/alignment/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.{cram,crai}' ]
    }
    withName: 'GATK4_APPLYBQSR' {
        ext.prefix = { "${meta.id}.recal" }
        publishDir = [ path: { "${params.outdir}/alignment/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.{cram,crai}' ]
    }

    // ---------------- GPU (NVIDIA Parabricks) ----------------
    withName: 'BWA_INDEX' {
        publishDir = [ enabled: false ]
    }
    withName: 'PARABRICKS_FQ2BAM|PARABRICKS_FQ2BAM_DOCKER' {
        ext.args   = '--bwa-options="-K 100000000 -Y"'
        publishDir = [ path: { "${params.outdir}/alignment/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.{bam,bai,table}' ]
    }
    withName: 'PARABRICKS_DEEPVARIANT' {
        publishDir = [ path: { "${params.outdir}/variants/deepvariant/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'BCFTOOLS_NORM_GPU' {
        ext.args   = '--multiallelics -both --check-ref w'
        ext.prefix = { "${meta.id}.norm" }
    }

    // ---------------- Small variants ----------------
    withName: 'DEEPVARIANT_RUNDEEPVARIANT' {
        ext.args   = { "--model_type=${params.dv_model_type}" }
        publishDir = [ path: { "${params.outdir}/variants/deepvariant/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'BCFTOOLS_NORM' {
        ext.args   = '--multiallelics -both --check-ref w'
        ext.prefix = { "${meta.id}.norm" }
        // the normalised VCF is what portrait mode takes in its `vcf` column
        publishDir = [ path: { "${params.outdir}/variants/${params.variant_caller}/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.vcf.gz*' ]
    }

    // ---------------- SV / CNV ----------------
    withName: 'MANTA_GERMLINE' {
        publishDir = [ path: { "${params.outdir}/variants/manta/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'CNVPYTOR' {
        ext.args   = '100000'   // read-depth bin size (bp)
        publishDir = [ path: { "${params.outdir}/variants/cnvpytor/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }

    // ---------------- Annotation ----------------
    withName: 'ENSEMBLVEP_VEP' {
        ext.args   = [
            '--everything --hgvs --symbol --canonical --mane --biotype --af_gnomadg',
            '--pick_allele_gene --check_existing --buffer_size 50000 --offline --cache'
        ].join(' ')
        publishDir = [ path: { "${params.outdir}/annotation/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'SNPSIFT_CLINVAR' {
        ext.prefix = { "${meta.id}.clinvar" }
    }

    // ---------------- Ancestry ----------------
    withName: 'PLINK2_PCA_PROJECT' {
        ext.args   = '--maf 0.01 --geno 0.05 --hwe 1e-6'
        publishDir = [ path: { "${params.outdir}/ancestry/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'ADMIXTURE_SUPERVISED' {
        publishDir = [ path: { "${params.outdir}/ancestry/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'PLINK2_ROH' {
        ext.args   = '--homozyg --homozyg-window-snp 50 --homozyg-snp 100 --homozyg-kb 1000'
    }

    // ---------------- Haplogroups ----------------
    withName: 'HAPLOGREP2' {
        publishDir = [ path: { "${params.outdir}/lineage/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'YLEAF' {
        publishDir = [ path: { "${params.outdir}/lineage/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }

    // ---------------- STR ----------------
    withName: 'HIPSTR' {
        publishDir = [ path: { "${params.outdir}/forensic_str/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'EXPANSIONHUNTER' {
        publishDir = [ path: { "${params.outdir}/forensic_str/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }

    // ---------------- Polygenic scores ----------------
    withName: 'PGS_MATCH' {
        memory = { 24.GB * task.attempt }   // ~5 GB for the reference table, shared by the workers
    }
    withName: 'PGS_TARGET' {
        publishDir = [ path: { "${params.outdir}/polygenic/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.pgs_target_stats.tsv' ]
    }
    withName: 'PGS_REPORT' {
        // the fragment is only an input to the unified report
        publishDir = [ path: { "${params.outdir}/polygenic/${meta.id}" }, mode: params.publish_dir_mode,
                       saveAs: { f -> (f == 'versions.yml' || f.endsWith('.pgs_fragment.html')) ? null : f } ]
    }

    // ---------------- HLA ----------------
    withName: 'HLA_T1K' {
        ext.args   = '--preset hla-wgs'
        publishDir = [ path: { "${params.outdir}/hla/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }

    // ---------------- Pharmacogenomics ----------------
    withName: 'PHARMCAT' {
        publishDir = [ path: { "${params.outdir}/pharmacogenomics/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }

    // ---------------- Traits / extras ----------------
    withName: 'TRAIT_LOOKUP' {
        publishDir = [ path: { "${params.outdir}/traits/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'TELSEQ' {
        publishDir = [ path: { "${params.outdir}/extras/telomere/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'MUTSERVE' {
        publishDir = [ path: { "${params.outdir}/extras/mito/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }

    // ---------------- Reporting ----------------
    withName: 'GENOMEPORTRAIT_REPORT' {
        publishDir = [ path: { "${params.outdir}/report" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [ path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode, saveAs: { f -> f == 'versions.yml' ? null : f } ]
    }

    // ---------------- Small per-sample tables ----------------
    withName: 'BCFTOOLS_STATS|BCFTOOLS_STATS_INPUT' {
        publishDir = [ path: { "${params.outdir}/variants/stats/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.txt' ]
    }
    withName: 'EXTRAS_REPORT' {
        publishDir = [ path: { "${params.outdir}/extras" }, mode: params.publish_dir_mode, pattern: '*.tsv' ]
    }

    // ---------------- Never published ----------------
    // References, indices and containers live in reference_base (storeDir); copying them
    // into results/ duplicated ~145 GB per run in v1. The rest are intermediates that only
    // feed the next step.
    withName: 'DL_.*|DOWNLOAD_.*|BUILD_.*|BWAMEM2_INDEX|BWA_INDEX|SAMTOOLS_FAIDX|GATK4_CREATESEQUENCEDICTIONARY|CHECK_GPU|PGS_FETCH|PGS_PANEL_DOWNLOAD|PGS_SITES|PGS_REFERENCE|PGS_MATCH|PGS_SCORE_REFERENCE|PGS_PROJECT|BWAMEM2_MEM|MINIMAP2_ALIGN|SAMTOOLS_INDEX|CRAM_TO_BAM|HLA_EXTRACT_FASTQ|GATK4_BASERECALIBRATOR|MERGE_STR_CATALOG|PLINK2_ANCESTRY_PANEL|PLINK2_ANCESTRY_SAMPLE|PLINK_ANCESTRY_MERGE|BCFTOOLS_GENOTYPE_SITES|TRAIT_GENOTYPE|MITO_CALL' {
        publishDir = [ enabled: false ]
    }

}
